#!/usr/bin/env python3
"""Block a commit that changes a level document without a full self-check.

For each staged docs/spec/*.md, the self-check table must exist at
<git dir>/ff-selfcheck/<blob hash of the staged file>.md and name every
requirement (R<n>), scenario (S<n>) and measure (M<n>) in that file.
"""
import re
import subprocess
import sys


def git(*args: str) -> str:
    return subprocess.run(
        ["git", *args], capture_output=True, text=True, check=True
    ).stdout


def ids(doc: str) -> list[str]:
    found: list[str] = []
    section = None
    count = {"R": 0, "M": 0}
    for line in doc.splitlines():
        if line.startswith("**Achieves"):
            section = "R"
            continue
        if line.startswith("**Measured"):
            section = "M"
            continue
        if section and line.startswith("- "):
            count[section] += 1
            found.append(f"{section}{count[section]}")
            continue
        if section and line.strip() and not line.startswith("- "):
            section = None
        row = re.match(r"^\|\s*(\d+)\s*\|", line)
        if row:
            found.append(f"S{row.group(1)}")
    return found


def main() -> int:
    staged = git(
        "diff", "--cached", "--name-only", "--diff-filter=ACMR", "--", "docs/spec/*.md"
    ).split()
    if not staged:
        return 0
    tables = git("rev-parse", "--git-path", "ff-selfcheck").strip()
    problems: list[str] = []
    for path in staged:
        blob = git("rev-parse", f":{path}").strip()
        table_path = f"{tables}/{blob}.md"
        try:
            with open(table_path, encoding="utf-8") as f:
                table = f.read()
        except FileNotFoundError:
            problems.append(
                f"{path}: no self-check table for this version. Run write-outcome's "
                f"full self-check on the whole document and write it to {table_path}."
            )
            continue
        missing = [i for i in ids(git("show", f":{path}")) if not re.search(rf"\b{i}\b", table)]
        if missing:
            problems.append(
                f"{path}: the self-check table {table_path} doesn't cover: {', '.join(missing)}."
            )
    if problems:
        print("Commit blocked: a level document changed without a full self-check.", file=sys.stderr)
        for p in problems:
            print(f"- {p}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
